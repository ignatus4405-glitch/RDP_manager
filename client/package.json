{
  "name": "rdp-manager-client",
  "version": "1.4.5",
  "private": true,
  "description": "Electron-клиент RDP Manager и GUI управления Windows-службой сервера",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server-manager": "electron . --server-manager",
    "dist": "npm run build:ironrdp && electron-builder",
    "build:ironrdp": "node scripts/build-ironrdp.js",
    "stage:windows-server": "node scripts/stage-windows-server.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "ironrdp-wasm": "^1.3.0"
  },
  "build": {
    "appId": "com.rdpmanager.client",
    "productName": "RDP Manager",
    "files": [
      "main.js",
      "preload.js",
      "server-manager-utils.js",
      "update-controller.js",
      "rdp-file-writer.js",
      "clipboard-file-source.js",
      "rdp-clipboard-receiver.js",
      "clipboard-rich.js",
      "windows-virtual-clipboard.js",
      "renderer/**",
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "artifactName": "RDPManager-Setup-${version}.${ext}",
      "extraResources": [{ "from": "build/rdp-virtual-clipboard.exe", "to": "rdp-virtual-clipboard.exe" }]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "language": "1049",
      "installerLanguages": ["ru_RU"],
      "multiLanguageInstaller": true,
      "shortcutName": "RDP Manager"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "assets/icon.png",
      "artifactName": "RDPManager-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ignatus4405-glitch",
        "repo": "RDP_manager"
      }
    ]
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "author": {
    "name": "RDP Manager Team"
  },
  "license": "UNLICENSED"
}
