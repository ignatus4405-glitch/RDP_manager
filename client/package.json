{
  "name": "rdp-manager-client",
  "version": "1.3.3",
  "private": true,
  "description": "Десктоп-клиент RDP Manager: запуск RDP / AnyDesk / RustDesk подключений и просмотр документации",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npm run build:ironrdp && electron-builder",
    "build:ironrdp": "node scripts/build-ironrdp.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "ironrdp-wasm": "^1.3.0"
  },
  "build": {
    "appId": "com.rdpmanager.client",
    "productName": "RDP Manager",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "artifactName": "RDPManager-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "RDP Manager"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "assets/icon.png",
      "artifactName": "RDPManager-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ignatus4405-glitch",
        "repo": "RDP_manager"
      }
    ]
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "author": {
    "name": "RDP Manager Team"
  },
  "license": "UNLICENSED"
}
