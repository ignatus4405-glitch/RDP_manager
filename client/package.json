{
  "name": "rdp-manager-client",
  "version": "1.0.0",
  "private": true,
  "description": "Десктоп-клиент RDP Manager: запуск RDP / AnyDesk / RustDesk подключений и просмотр документации",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron": "^45.3.3"
  },
  "devDependencies": {
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.rdpmanager.client",
    "productName": "RDP Manager",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "RDP Manager"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "assets/icon.png"
    }
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
