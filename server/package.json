{
  "name": "rdp-manager-server",
  "version": "1.4.13",
  "private": true,
  "description": "Серверная часть RDP Manager: база подключений RDP / AnyDesk / RustDesk, документация, учётные записи администраторов",
  "main": "src/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
