  },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.23.0"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  }
}
